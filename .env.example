[TEMPLATE]
# =============================================================
# Duka Scraper — Environment Variables
# =============================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Only POSTGRES_PASSWORD and HOSTED_LLM_API_KEY are required.
# Everything else has sensible defaults for local development.
# =============================================================

# --- Project ---
COMPOSE_PROJECT_NAME=duka_scraper

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=duka_system
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DUKA_SYSTEM_DB=duka_system

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://elasticsearch:9200

# --- ClickHouse ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=duka_scraper
CLICKHOUSE_PASSWORD=

# --- JWT / Auth ---
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_URL=http://localhost:5173/reset-password
EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
LOGIN_RATE_LIMIT_PER_MINUTE=10
RESET_RATE_LIMIT_PER_HOUR=5

# --- Bootstrap admin (created on first API start) ---
INITIAL_ADMIN_EMAIL=dukascraper@gmail.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME
INITIAL_ADMIN_NAME=System Administrator

# --- SMTP (Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# --- Hosted LLM (Groq) ---
HOSTED_LLM_API_KEY=CHANGE_ME
HOSTED_LLM_URL=https://api.groq.com/openai/v1/chat/completions
HOSTED_LLM_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=hosted

# --- RAG / Embedding ---
RAG_ENABLED=true
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://ollama-embedding:11434
EMBEDDING_MODEL=nomic-embed-text
VECTOR_DB_URL=http://qdrant:6333
VECTOR_DB_COLLECTION=duka_articles

# --- Gmail OAuth2 (for auto-signup verification emails) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- IMAP (reads verification codes from email — used for 2FA auto-verification) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_USE_SSL=true
SEED_GMAIL_EMAIL=
SEED_GMAIL_PASSWORD=

# --- Monitoring ---
GRAFANA_ADMIN_PASSWORD=admin
PAGERDUTY_SERVICE_KEY=
SLACK_WEBHOOK_URL=

# --- Worker tuning ---
RESIDENTIAL_PROXY=
