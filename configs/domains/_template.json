{
    "_comment": "TEMPLATE — Copy this file and customize for your portal. Delete this file in production.",
    "domain": "CHANGE_ME.example.com",
    "name": "CHANGE_ME Portal Name",
    "description": "Describe what this portal is and what data you want to extract.",
    "handle_http_interstitial": true,
    "login_url": null,
    "login_steps": [
        {
            "action": "fill",
            "selector": "input[name='username'], input[type='email'], input[id='username']",
            "value": "$username",
            "wait_after_ms": 500,
            "description": "Fill username field"
        },
        {
            "action": "fill",
            "selector": "input[type='password']",
            "value": "$password",
            "wait_after_ms": 500,
            "description": "Fill password field"
        },
        {
            "action": "click",
            "selector": "button[type='submit'], input[type='submit'], button:has-text('Login')",
            "wait_after_ms": 5000,
            "description": "Click submit button"
        }
    ],
    "post_login_targets": [
        "/dashboard",
        "/grades",
        "/results"
    ],
    "post_login_steps": [
        {
            "action": "wait",
            "wait_after_ms": 3000,
            "description": "Wait for dashboard to render"
        }
    ],
    "extraction_targets": [
        {
            "name": "student_info",
            "type": "form_values",
            "field_selectors": {
                "name": ".student-name, #studentName",
                "id": ".student-id, #studentId",
                "department": ".department, #department",
                "program": ".program, #program"
            }
        },
        {
            "name": "grades",
            "type": "table",
            "table_selector": "table",
            "column_mapping": {
                "course_code": "course code",
                "course_name": "course name",
                "credit_hours": "credit",
                "grade": "grade",
                "gpa_points": "gpa"
            }
        },
        {
            "name": "summary",
            "type": "custom",
            "js_extract": "(() => { const gpa = document.querySelector('.gpa, #gpa'); const credits = document.querySelector('.credits, #credits'); return { gpa: gpa ? gpa.innerText.trim() : '', credits: credits ? credits.innerText.trim() : '' }; })()"
        }
    ]
}
