{
    "domain": "linkedin.com",
    "name": "LinkedIn",
    "description": "LinkedIn login — email + password. Standard form login.",
    "handle_http_interstitial": false,
    "login_url": "https://www.linkedin.com/login",
    "login_steps": [
        {
            "action": "fill",
            "selector": "#username, input[name='session_key'], input[type='email']",
            "value": "$username",
            "wait_after_ms": 500,
            "description": "Fill email/username field"
        },
        {
            "action": "fill",
            "selector": "#password, input[name='session_password'], input[type='password']",
            "value": "$password",
            "wait_after_ms": 500,
            "description": "Fill password field"
        },
        {
            "action": "click",
            "selector": "button[type='submit'], button:has-text('Sign in'), button.login-form__submit-btn",
            "wait_after_ms": 5000,
            "description": "Click Sign in button"
        }
    ],
    "post_login_targets": [
        "/feed/",
        "/mynetwork/"
    ],
    "extraction_targets": [
        {
            "name": "feed_data",
            "type": "custom",
            "js_extract": "(() => { return { url: window.location.href, title: document.title, body_text: document.body ? document.body.innerText.substring(0, 5000) : '' }; })()",
            "description": "Extract LinkedIn feed/network data after login"
        }
    ]
}
