{
    "domain": "facebook.com",
    "name": "Facebook",
    "description": "Facebook login — email/password. Note: Facebook has aggressive bot detection; aged accounts + proxy recommended.",
    "handle_http_interstitial": false,
    "login_url": "https://www.facebook.com/login/",
    "login_steps": [
        {
            "action": "fill",
            "selector": "#email, input[name='email'], input[autocomplete='username']",
            "value": "$username",
            "wait_after_ms": 500,
            "description": "Fill email/phone field"
        },
        {
            "action": "fill",
            "selector": "#pass, input[name='pass'], input[type='password']",
            "value": "$password",
            "wait_after_ms": 500,
            "description": "Fill password field"
        },
        {
            "action": "click",
            "selector": "button[name='login'], input[name='login'], button:has-text('Log in'), button[type='submit']",
            "wait_after_ms": 5000,
            "description": "Click Log In button"
        }
    ],
    "post_login_targets": [
        "/",
        "/me"
    ],
    "extraction_targets": [
        {
            "name": "profile_data",
            "type": "custom",
            "js_extract": "(() => { return { url: window.location.href, title: document.title, body_text: document.body ? document.body.innerText.substring(0, 5000) : '' }; })()",
            "description": "Extract Facebook profile/page data after login"
        }
    ]
}
