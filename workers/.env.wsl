# =============================================================================
# WSL Worker Environment Variables
# =============================================================================
# These env vars are read by workers via os.getenv() at import time.
# They MUST be exported before launching any worker process.
# The startup script (start_workers.sh) sources this file automatically.
#
# To use: source workers/.env.wsl && python -m workers.surface-worker.main
# =============================================================================

# --- Core ---
export APP_ENV=wsl
export PYTHONPATH="${PYTHONPATH:+$PYTHONPATH:}$(dirname "$0")/.."

# --- Kafka (EXTERNAL listener on Windows Docker host) ---
export KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# --- PostgreSQL ---
export POSTGRES_HOST=localhost
export POSTGRES_PORT=5432

# --- Redis ---
export REDIS_URL=redis://localhost:6379/0

# --- MinIO ---
export MINIO_ENDPOINT=localhost:9000
export MINIO_ROOT_USER=minioadmin
export MINIO_ROOT_PASSWORD=minioadmin

# --- ClickHouse ---
export CH_HOST=localhost
export CH_PORT=8123
export CH_DATABASE=duka_scraper
export CLICKHOUSE_HOST=localhost
export CLICKHOUSE_HTTP_PORT=8123

# --- Elasticsearch ---
export ELASTICSEARCH_URL=http://localhost:9200

# --- Ollama Embedding (host port 11435 -> container 11434) ---
export EMBEDDING_BASE_URL=http://localhost:11435
export EMBEDDING_MODEL=nomic-embed-text

# --- Qdrant Vector DB ---
export VECTOR_DB_URL=http://localhost:6333
export VECTOR_DB_COLLECTION=duka_articles

# --- Tor ---
export tor_proxy_url=socks5://localhost:9050

# --- LLM (must be set manually) ---
# export HOSTED_LLM_API_KEY=your_groq_api_key_here
# export HOSTED_LLM_URL=https://api.groq.com/openai/v1/chat/completions
# export HOSTED_LLM_MODEL=openai/gpt-oss-120b
